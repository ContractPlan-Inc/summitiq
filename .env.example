# Application
NEXT_PUBLIC_APP_NAME=SummitIQ
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI & ML Services
OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_ENABLE_AI_FEATURES=true

# Speech-to-Text Services
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
DEEPGRAM_API_KEY=your_deepgram_key_here

# Database (Production)
DATABASE_URL=postgresql://user:password@localhost:5432/summitiq

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# CRM Integrations (Optional)
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
HUBSPOT_API_KEY=your_hubspot_api_key

# Video Platform Integrations
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Calendar Integrations
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Analytics & Monitoring
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id
SENTRY_DSN=your_sentry_dsn

# Feature Flags
NEXT_PUBLIC_ENABLE_REAL_TIME_TRANSCRIPTION=true
NEXT_PUBLIC_ENABLE_AI_COACHING=true
NEXT_PUBLIC_ENABLE_SENTIMENT_ANALYSIS=true
NEXT_PUBLIC_ENABLE_CRM_SYNC=false

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=ws://localhost:3001
